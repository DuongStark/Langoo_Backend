# Mẫu biến môi trường cho backend Langoo — copy thành .env rồi điền.
# KHÔNG commit file .env thật.

# ---------------------------------------------------------------- Database
# Prisma Postgres (cloud) — runtime dùng pooled, migration/DDL dùng direct.
# Lấy cả hai trong Prisma console → Connection strings.
# Khuyến nghị sslmode=verify-full (hoặc uselibpqcompat=true) để hết cảnh báo của pg 8.16+.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
# Pool `pg` (runtime + health check) — bỏ trống dùng mặc định 10 / 30000ms / 10000ms.
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DB_POOL_CONNECTION_TIMEOUT_MS=

# DB test local (bắt buộc cho `npm run db:test:reset` + `npm run test:e2e`).
# Tên DB PHẢI kết thúc bằng "_test" — script sẽ từ chối mọi tên khác.
# PostgreSQL 17 trên máy dev chạy cổng 5432 (khác cổng 55432 của bản nhúng cũ).
# `options=-c timezone=UTC` keeps Prisma Date binds and SQL now()/DEFAULT on
# the same instant even when the local PostgreSQL role defaults to Asia/Bangkok.
# TEST_DATABASE_URL="postgresql://postgres:MAT_KHAU@127.0.0.1:5432/langoo_test?options=-c%20timezone%3DUTC"
# TEST_DIRECT_URL="postgresql://postgres:MAT_KHAU@127.0.0.1:5432/langoo_test?options=-c%20timezone%3DUTC"

# ---------------------------------------------------------------- Ứng dụng
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------- M12 Hardening
# Rate limit auth (login 10/phút/IP, register 5/giờ/IP…); e2e tự đặt false.
RATE_LIMIT_ENABLED=true
# Scheduler nội bộ: dọn search_history, tạo partition review_log, retention chat.
SCHEDULER_ENABLED=true
# Xoá phiên chat không hoạt động quá N ngày (0 = tắt).
CHAT_RETENTION_DAYS=180

# ---------------------------------------------------------------- M13 Storage (ảnh feedback)
# local = thư mục STORAGE_DIR (dev); s3 = backlog (chọn sẽ fail-fast).
STORAGE_PROVIDER=local
STORAGE_DIR=uploads

# ---------------------------------------------------------------- Auth (bắt buộc từ M2)
# JWT_ACCESS_SECRET PHẢI ≥32 ký tự ngẫu nhiên — sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
# Dạng hợp lệ: số giây hoặc hậu tố s/m/h/d (ví dụ 900, 15m, 1h).
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# CORS cho web FE (deploy) — danh sách origin cách nhau dấu phẩy; bỏ trống = tắt.
# "*" = cho phép mọi origin (phản chiếu origin của request, dùng được cùng credentials).
# Ví dụ: CORS_ORIGINS="https://langoo-web.onrender.com,http://localhost:5173"
CORS_ORIGINS=

# Đăng nhập Google (OAuth2) — các client ID được chấp nhận (web/iOS/Android,
# cách nhau dấu phẩy). Bỏ trống = endpoint /v1/auth/oauth/google trả 503.
GOOGLE_OAUTH_CLIENT_IDS=
# Chỉ bật sau khi mọi client đã gọi challenge endpoint và gửi lại hai giá trị.
GOOGLE_OAUTH_REQUIRE_CHALLENGE=false

# ---------------------------------------------------------------- AI (M10)
# stub = trả lời demo, không cần key (mặc định). openai = OpenAI-compatible:
# dùng được OpenAI hoặc gateway (ví dụ OpenCode Zen: AI_BASE_URL=https://opencode.ai/zen/v1).
AI_PROVIDER=stub
AI_API_KEY=
AI_CHAT_MODEL=
AI_BASE_URL=
# Quota chat/ngày theo timezone user (bỏ trống = 50).
AI_DAILY_REQUEST_LIMIT=50
# Quiz: quota sinh quiz/ngày (bỏ trống = 15) + cooldown giữa 2 lần sinh (ms, bỏ trống = 15000).
AI_QUIZ_DAILY_LIMIT=15
AI_QUIZ_COOLDOWN_MS=15000
