[Unit]
Description=DB4-D4/D5 shadow mapping batch (%i)
Wants=network-online.target
After=network-online.target muse-bridge.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=simple
User=langoo
Group=langoo
WorkingDirectory=/opt/langoo/services/db4-batch
EnvironmentFile=/etc/langoo/db4-batch/%i.env
UMask=0077
ExecStart=/opt/langoo/services/muse-native/venv/bin/python -B ${DB4_RELEASE_PATH}/scripts/ops/db4-batch/run-shadow.py --artifact-root=${DB4_ARTIFACT_ROOT} --manifest=${DB4_MANIFEST} --workers=${DB4_WORKERS} --timeout=${DB4_TIMEOUT} --r1-cap=${DB4_R1_CAP} --r2-cap=${DB4_R2_CAP}
Restart=on-abnormal
RestartSec=60
RestartPreventExitStatus=130
TimeoutStartSec=0
TimeoutStopSec=900
KillSignal=SIGTERM
KillMode=control-group
MemoryHigh=700M
MemoryMax=800M
CPUQuota=100%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/langoo/services/muse-native /opt/langoo/storage/muse-native/cookies.json
ReadWritePaths=/opt/langoo/storage/db4-batches /opt/langoo/storage/muse-native

[Install]
WantedBy=multi-user.target
